---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  active?: "home" | "docs";
  copyControls?: boolean;
  noindex?: boolean;
}
const { title, description, active = "home", copyControls = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://getswarmforge.tech");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4ef" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    {copyControls && <script is:inline src="/assets/site.js" defer></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader active={active} />
    <slot />
    <SiteFooter />
  </body>
</html>
